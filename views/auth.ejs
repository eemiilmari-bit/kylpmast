<%- include('partials/header') %>
<section class="grid two">
  <div class="card">
    <h2>Create account</h2>
    <form action="/register" method="POST" enctype="multipart/form-data" class="stack">
      <label>Name
        <input type="text" name="name" required />
      </label>
      <label>Password
        <input type="password" name="password" required />
      </label>
      <label>Profile picture (optional)
        <input type="file" name="avatar" accept="image/*" />
      </label>
      <button type="submit">Register</button>
    </form>
  </div>
  <div class="card">
    <h2>Login</h2>
    <% if (error === 'login') { %>
      <p class="error">Login failed. Check your details.</p>
    <% } else if (error === 'banned') { %>
      <p class="error">This account is banned.</p>
    <% } else if (error === 'missing') { %>
      <p class="error">Please fill out all required fields.</p>
    <% } else if (error === 'exists') { %>
      <p class="error">That username is already taken.</p>
    <% } %>
    <form action="/login" method="POST" class="stack">
      <label>Name
        <input type="text" name="name" required />
      </label>
      <label>Password
        <input type="password" name="password" required />
      </label>
      <button type="submit" class="secondary">Login</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
