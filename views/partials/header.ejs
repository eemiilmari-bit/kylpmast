<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clown Quiz</title>
  <link rel="stylesheet" href="/public/css/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">Clown Quiz</div>
    <nav>
      <a href="/">Home</a>
      <a href="/auth">Auth</a>
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/quiz">Quiz</a>
        <a href="/leaderboard">Leaderboard</a>
        <a href="/chat">Chat</a>
        <a href="/messages">Messages</a>
        <% if (currentUser.role === 'Admin' || currentUser.role === 'Owner') { %>
          <a href="/admin">Admin</a>
        <% } %>
      <% } %>
    </nav>
    <div class="auth-links">
      <% if (currentUser) { %>
        <form action="/logout" method="POST">
          <button class="secondary" type="submit">Logout</button>
        </form>
      <% } else { %>
        <a class="button" href="/auth">Login</a>
      <% } %>
    </div>
  </header>
  <% if (activeAnnouncement) { %>
    <div class="announcement">
      <div><strong><%= activeAnnouncement.type %>:</strong> <%= activeAnnouncement.content %></div>
      <% if (currentUser) { %>
      <form method="POST" action="/announcement/<%= activeAnnouncement.id %>/dismiss">
        <button type="submit" class="link">Dismiss</button>
      </form>
      <% } %>
    </div>
  <% } %>
  <main class="container">
